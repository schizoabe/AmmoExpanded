-- ── Caliber variant tables ────────────────────────────────────────────────────
-- Builds the standard 6-variant set (FMJ / HP / AP / NL / EMP / INC).
local function stdVariants(prefix)
    return {
        { id = prefix,          label = "FMJ",            short = "FMJ"  },
        { id = prefix .. "_HP", label = "Hollow Point",   short = "HP"   },
        { id = prefix .. "_AP", label = "Armor Pierce",   short = "AP"   },
        { id = prefix .. "_NL", label = "Non-Lethal",     short = "NL"   },
        { id = prefix .. "_EMP",label = "EMP",            short = "EMP"  },
        { id = prefix .. "_INC",label = "Incendiary",     short = "INC"  },
    }
end

-- Smart/Tech calibers have no HP/AP/etc. suffix variants in the data — just one
-- base round each (NPC-loot-only calibers originally, no player variant picker).
-- Still worth showing in CET so the player can see/select the single type rather
-- than the loader reporting "not a DPAE weapon" for these guns.
local function singleVariant(id, label, short)
    return { { id = id, label = label, short = short } }
end

-- Cal9x19 prototype: chemical/poison round, on top of the standard 6. Not added to
-- stdVariants() itself since only Cal9x19 has the Ammo.Cal9x19_CHEM record right
-- now — adding it to the shared helper would show a non-functional "Chemical --"
-- placeholder on the other 10 standard calibers that don't have it yet. Expand to
-- the rest by building each one the same way once this is confirmed working.
local cal9x19Variants = stdVariants("Ammo.Cal9x19")
table.insert(cal9x19Variants, { id = "Ammo.Cal9x19_CHEM", label = "Chemical", short = "CHEM" })

