Vendors.$(sv):
  $instances:
    - { sv: wat_kab_gunsmith_01 }     # Watson / Kabuki
    - { sv: wat_kab_gunsmith_02 }     # Watson / Kabuki — second shop
    - { sv: wat_lch_gunsmith_01 }     # Watson / Little China — Wilson's 2nd Amendment
    - { sv: wat_nid_gunsmith_01 }     # Watson / Northside Industrial
    - { sv: hey_gle_gunsmith_01 }     # Heywood / The Glen
    - { sv: hey_rey_gunsmith_01 }     # Heywood / Reynosa
    - { sv: hey_spr_gunsmith_01 }     # Heywood / Vista del Rey
    - { sv: wbr_jpn_gunsmith_01 }     # Westbrook / Japantown
    - { sv: pac_wwd_gunsmith_01 }     # Pacifica / West Wind Estate
    - { sv: std_arr_gunsmith_01 }     # Santo Domingo / Arroyo
    - { sv: std_rcr_gunsmith_01 }     # Santo Domingo / Rancho Coronado
    - { sv: cct_dtn_guns_01 }         # City Center / Downtown
    - { sv: bls_ina_se1_gunsmith_02 } # Dogtown — sector 1
    - { sv: bls_ina_se5_gunsmith_01 } # Dogtown — sector 5
