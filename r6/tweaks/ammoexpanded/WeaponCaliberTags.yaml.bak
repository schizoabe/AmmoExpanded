#         M2038 Tactician, Bloody Maria (Preset_Tactician_Dino),
#         Crusher, Amstaff (Preset_Crusher_Amazon)
# Note: THE HEADSMAN is Tactician-based (Preset_Tactician_Headsman) — inherits
#       Gauge12 but Sheet1 says "slug only". Slug is a Gauge12 variant, correct.
# Tube-fed: Base_Tactician (Tactician, Bloody Maria, Headsman).
#           Base_Pozhar and Base_Crusher are magazine-fed — no DPAE_TubeFed.
# ═══════════════════════════════════════════════════════════════════════════

Items.Base_Pozhar:
  tags:
    - !append-once DPAE_Gauge12

Items.Base_Tactician:
  tags:
    - !append-once DPAE_Gauge12
    - !append-once DPAE_TubeFed

Items.Base_Crusher:
  tags:
    - !append-once DPAE_Gauge12

