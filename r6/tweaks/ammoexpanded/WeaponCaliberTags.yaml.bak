# DPAE Weapon Caliber Tags
# ---------------------------------------------------------------------------
# Tags on base records propagate to ALL presets via TweakDB inheritance.
# Only add a specific preset when an iconic needs to OVERRIDE its base caliber.
#
# Check-order rule (enforced in DPAE_GetCaliberFromEntity):
#   When a preset inherits a base tag AND carries its own override tag, the
#   override wins because it's checked first in the function. Two examples:
#     Dying Night  → Preset_Lexington_Wilson gets Cal11p43x23 (overrides inherited Cal9x19)
#     Hypercritical→ Preset_Kolac_Tiny_Mike gets Cal12p7x90R (overrides Cal12p7x83R)
#     Death & Taxes→ Preset_Nue_Maiko gets Cal9x19 via DPAE_Cal9x19Prec (escapes inherited Cal11p43x23)
#     Cheetah      → Preset_Unity_Angelica gets Cal9x19 via DPAE_Cal9x19Prec (escapes inherited Cal11p43x23)
#     Nowaki       → Preset_Masamune_Arasaka gets Cal7p62x51 (overrides inherited Cal5p56x45)
#
# ---------------------------------------------------------------------------

# ═══════════════════════════════════════════════════════════════════════════
# Cal9x19 — 9x19mm Parabellum
# Covers: M-10AF Lexington, Lexington X-MOD2, Rook, Slaught-O-Matic,
#         Guillotine, Guillotine X-MOD2, M221 Saratoga, Problem Solver,
#         Fenrir (Preset_Saratoga_Maelstrom), Shigure (Preset_Saratoga_Arasaka)
# ═══════════════════════════════════════════════════════════════════════════

Items.Base_Lexington:
  tags:
    - !append-once DPAE_Cal9x19

Items.Base_Slaughtomatic:
  tags:
    - !append-once DPAE_Cal9x19

Items.Base_Guillotine:
  tags:
    - !append-once DPAE_Cal9x19

Items.Base_Saratoga:
  tags:
    - !append-once DPAE_Cal9x19

# Override: Dying Night (Items.Preset_Lexington_Wilson) is Lexington-based and
# inherits Cal9x19 from Base_Lexington, but DPAE reassigns it to .45 ACP.
# Cal11p43x23 is checked first in DPAE_GetCaliberFromEntity, so it wins.
# The Rare/Epic/Legendary quality tiers inherit from Preset_Lexington_Wilson
# and will pick up this tag automatically.
Items.Preset_Lexington_Wilson:
  tags:
    - !append-once DPAE_Cal11p43x23

# Plan B (Items.Preset_Liberty_Dex) is Dex's Liberty — inherits Cal11p43x23
# from Base_Liberty. No separate entry needed.

# Pride (Items.Preset_Liberty_Rogue) is Rogue's Liberty — inherits Cal11p43x23.
# Kongou (Items.Preset_Liberty_Yorinobu) is Yorinobu's Liberty — inherits Cal11p43x23.
# Her Majesty (Items.Preset_Unity_Agent) is Unity-based — inherits Cal11p43x23.

# Override: Death and Taxes (Preset_Nue_Maiko) inherits Cal11p43x23 from Base_Nue, but
# DPAE reassigns it to 9mm. DPAE_Cal9x19Prec is checked first, before Cal11p43x23, so it
# wins. Cheetah (Preset_Unity_Angelica) uses the same escape for the same reason.
Items.Preset_Nue_Maiko:
  tags:
    - !append-once DPAE_Cal9x19Prec

Items.Preset_Unity_Angelica:
  tags:
    - !append-once DPAE_Cal9x19Prec

# ═══════════════════════════════════════════════════════════════════════════
# Cal11p43x23 — .45 ACP
# Covers: Liberty, Plan B (Preset_Liberty_Dex), Kongou, Pride, Seraph,
#         Nue, La Chingona Dorada (Preset_Nue_Jackie), Riskit, Tamayura,
#         Unity, Her Majesty (Preset_Unity_Agent), Dying Night (direct override)
# Note: Death and Taxes and Cheetah are EXCLUDED — they escape to Cal9x19 via
#       DPAE_Cal9x19Prec tags above.
# ═══════════════════════════════════════════════════════════════════════════

Items.Base_Liberty:
  tags:
    - !append-once DPAE_Cal11p43x23

Items.Base_Nue:
  tags:
    - !append-once DPAE_Cal11p43x23

Items.Base_Unity:
  tags:
    - !append-once DPAE_Cal11p43x23

