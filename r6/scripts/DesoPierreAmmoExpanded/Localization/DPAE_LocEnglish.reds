    this.Text("AmmoExpanded-Cal7p62x39Sov-NL-Desc", "7.62x39mm cartridge with a rubber projectile. Incapacitates the target.");
    this.Text("AmmoExpanded-Cal7p62x39Sov-CHEM-Desc", "7.62x39mm cartridge containing an engineered rapidly-decaying neurotoxin. The projectile is designed to fragment inside the body, allowing the neurotoxin to spread, resulting in the disruption of muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal7p62x39Sov-INC-Desc", "7.62x39mm cartridge containing incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal7p62x39Sov-EMP-Desc", "7.62x39mm cartridge containing a micro-capacitor. After penetrating the target, the embedded projectile shatters and the capacitor discharges, delivering a high-voltage shock to the target.");
    this.Text("AmmoExpanded-Cal7p62x39Sov-HP-Desc", "7.62x39mm copper-jacketed lead projectile with an open cavity at the tip. Upon impacting a soft target, the projectile mushrooms outward, leading to increased tissue destruction and heavy bleeding.");
    this.Text("AmmoExpanded-Cal7p62x39Sov-AP-Desc", "7.62x39mm copper-jacketed lead projectile encapsulating a dense, hardened-tungsten rod core. Improved performance against armor.");
    this.Text("AmmoExpanded-Cal8x30RailF-CHEM-Desc", "8x30mm tungsten rail flechette containing an engineered rapidly-decaying neurotoxin. The flechettes are designed to fragment inside the body. After fragmenting, the toxin is released which results in the disruption of muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal8x30RailF-INC-Desc", "8x30mm tungsten rail flechette coated in an incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal8x30RailF-EMP-Desc", "8x30mm tungsten rail flechette containing a micro-capacitor. After penetrating the target, the embedded flechettes' capacitors discharge, delivering high-voltage shocks to the target.");
    this.Text("AmmoExpanded-Cal8x30TShot-CHEM-Desc", "8x30mm tungsten shot pellet containing an engineered rapidly-decaying neurotoxin. The flechettes are designed to fragment inside the body. After fragmenting, the toxin is released which results in the disruption of muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal8x30TShot-INC-Desc", "8x30mm tungsten shot pellet coated in an incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal8x30TShot-EMP-Desc", "8x30mm tungsten shot pellet containing a micro-capacitor. After penetrating the target, the embedded flechettes' capacitors discharge, delivering high-voltage shocks to the target.");
    this.Text("AmmoExpanded-Cal9p5x35Minirocket-HE-Desc", "9.5x35mm guided rocket containing explosive compound. Devastating to all targets.");
    this.Text("AmmoExpanded-Cal9p5x35Minirocket-CHEM-Desc", "9.5x35mm guided rocket containing a chemical payload. Upon impacting a target, the payload disperses, disrupting muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal9p5x35Minirocket-INC-Desc", "9.5x35mm guided rocket containing incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal9p5x35Minirocket-EMP-Desc", "9.5x35mm guided rocket containing a micro-capacitor. Upon impacting a target, the payload discharges a high voltage jolt to the target capable of disrupting cyberware.");
    this.Text("AmmoExpanded-Cal9x19-HE-Desc", "9x19mm cartridge containing explosive compound. Devastating to all targets.");
    this.Text("AmmoExpanded-Cal9x19-NL-Desc", "9x19mm cartridge with a rubber projectile. Incapacitates the target.");
    this.Text("AmmoExpanded-Cal9x19-INC-Desc", "9x19mm cartridge containing incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal9x19-EMP-Desc", "9x19mm cartridge containing a micro-capacitor. After penetrating the target, the embedded projectile shatters and the capacitor discharges, delivering a high-voltage shock.");
    this.Text("AmmoExpanded-Cal9x19-HP-Desc", "9x19mm copper-jacketed lead projectile with an open cavity at the tip. Upon impacting a soft target, the projectile mushrooms outward, leading to increased tissue destruction and heavy bleeding. Not intended for use against armored targets.");
    this.Text("AmmoExpanded-Cal9x19-AP-Desc", "9x19mm copper-jacketed lead projectile encapsulating a dense, hardened-steel rod core. Improved performance against armor.");
    this.Text("AmmoExpanded-Cal9x30TF-CHEM-Desc", "9x30mm tungsten flechette containing an engineered rapidly-decaying neurotoxin. The flechettes are designed to fragment inside the body. After fragmenting, the toxin is released which results in the disruption of muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal9x30TF-INC-Desc", "9x30mm tungsten flechette coated in an incendiary compound. Upon impacting a target, the compound ignites, covering the target in flames.");
    this.Text("AmmoExpanded-Cal9x30TF-EMP-Desc", "9x30mm tungsten flechette containing a micro-capacitor. After penetrating the target, the embedded flechettes' capacitors discharge, delivering high-voltage shocks to the target.");
    this.Text("AmmoExpanded-PyroMod-Desc", "While Incendiary ammo is chambered, increases the percentage of damage converted to Thermal and the chance to apply Burn. Also raises the odds of a bonus Overheating effect. Scales with quality; stacks with additional copies.");
    this.Text("AmmoExpanded-ArcMod-Desc", "While EMP ammo is chambered, increases the percentage of damage converted to Electric and the chance to apply Shock. Also unlocks a chance to physically disable the target's cyberware. Scales with quality; stacks with additional copies.");
    this.Text("AmmoExpanded-CausticMod-Desc", "While Chemical ammo is chambered, increases the percentage of damage converted to Chemical and the chance to apply Poison. Also raises the odds of a bonus Corroded effect. Scales with quality; stacks with additional copies.");
