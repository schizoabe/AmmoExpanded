    this.Text("AmmoExpanded-Settings-Category", "Toggles");
    this.Text("AmmoExpanded-Settings-AccurateDamageColors", "Accurate Damage Colors");
    this.Text("AmmoExpanded-Settings-AccurateDamageColors-Desc", "Show the real elemental color (Thermal/Electric/Chemical) on the initial hit's damage number when converted ammo is active, instead of vanilla always showing Physical for direct hits. Purely cosmetic — the actual damage dealt is correct either way; this only affects the on-screen number's color.");
    this.Text("AmmoExpanded-Settings-TrueDamageConversion", "True Damage Conversion");
    this.Text("AmmoExpanded-Settings-TrueDamageConversion-Desc", "On: elemental ammo (Incendiary/EMP/Chemical) genuinely shifts damage out of Physical into Thermal/Electric/Chemical, same as vanilla Pyro's own conversion. Off: elemental damage is simply added on top of full, unreduced Physical damage instead.");
    this.Text("AmmoExpanded-Settings-ForceReloadOnAmmoSwitch", "Realistic Magazine");
    this.Text("AmmoExpanded-Settings-ForceReloadOnAmmoSwitch-Desc", "Turn on to waste ammo when reloading with a non-empty mag, switching variant. Turn off if babby shit.");
    this.Text("AmmoExpanded-Settings-AmmoStarterSafetyNet", "EXPERTIMENTAL: Ammo Starter Safety Net");
    this.Text("AmmoExpanded-Settings-AmmoStarterSafetyNet-Desc", "On: Keeps V's ammo topped up during a fixed set of hard, inescapable scripted scenes (tutorial, possession sequences, forced story fights) so he can never run dry mid-scene. Off: strict behavior, ammo only ever comes from what's actually found, bought, or crafted.");
    this.Text("AmmoExpanded-Settings-DebugAmmoLogging", "Debug Ammo Logging");
    this.Text("AmmoExpanded-Settings-DebugAmmoLogging-Desc", "Important logging send to Pierre the results if u want to help out.");
