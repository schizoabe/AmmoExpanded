import Codeware.Localization.*

public class DPAE_LocEnglish extends ModLocalizationPackage {
  protected func DefineTexts() -> Void {

    this.Text("DPAE.Mod.Name", "Ammo Expanded");
    this.Text("DPAE.Mod.Desc", "Ammo variants for every caliber: hotkey switching, elemental damage, armor penetration.");
    this.Text("DPAE.tab.Main", "Settings");
    this.Text("DPAE.sec.Keys", "Key Bindings");
    this.Text("DPAE.sec.Gameplay", "Gameplay");
    this.Text("DPAE.sec.Debug", "Debug");
    this.Text("DPAE.CycleAmmo.Name", "Cycle Ammo Variant");
    this.Text("DPAE.CycleAmmo.Desc", "Cycles the currently drawn weapon to its next available ammo variant.");
    this.Text("DPAE.DropWeapon.Name", "Drop Current Weapon");
    this.Text("DPAE.DropWeapon.Desc", "Drops the currently equipped weapon without opening the inventory.");
    this.Text("DPAE.AccurateDamageColors.Name", "Accurate Damage Colors");
    this.Text("DPAE.AccurateDamageColors.Desc", "Show the real elemental color (Thermal/Electric/Chemical) on the initial hit's damage number when converted ammo is active, instead of vanilla always showing Physical for direct hits. Purely cosmetic — the actual damage dealt is correct either way; this only affects the on-screen number's color.");
    this.Text("DPAE.TrueDamageConversion.Name", "True Damage Conversion");
    this.Text("DPAE.TrueDamageConversion.Desc", "On: elemental ammo (Incendiary/EMP/Chemical) genuinely shifts damage out of Physical into Thermal/Electric/Chemical, same as vanilla Pyro's own conversion. Off: elemental damage is simply added on top of full, unreduced Physical damage instead.");
    this.Text("DPAE.ForceReload.Name", "Realistic Magazine");
    this.Text("DPAE.ForceReload.Desc", "Turn on to waste ammo when reloading with a non-empty mag, switching variant. Turn off if babby shit.");
    this.Text("DPAE.SafetyNet.Name", "EXPERIMENTAL: Ammo Starter Safety Net");
    this.Text("DPAE.SafetyNet.Desc", "On: Keeps V's ammo topped up during a fixed set of hard, inescapable scripted scenes (tutorial, possession sequences, forced story fights) so he can never run dry mid-scene. Off: strict behavior, ammo only ever comes from what's actually found, bought, or crafted.");
    this.Text("DPAE.DebugLog.Name", "Debug Ammo Logging");
    this.Text("DPAE.DebugLog.Desc", "Writes a detailed ammo log to r6/logs/mods/AmmoExpanded__*.log (needs RedLogger; also viewable in the hub under LOGS). Send it to Pierre if you want to help out.");

    this.Text("AmmoExpanded-Cal9x19-Name", "9x19mm Parabellum");
    this.Text("AmmoExpanded-Cal9x19-Desc", "9x19mm copper-jacketed lead projectile housed in a brass casing. While it has remained in service for over 150 years, its efficacy has declined significantly over the last half-century due to the widespread adoption of cheaper grades of subdermal armor. Despite these limitations in stopping power, it has served as the primary chambering for the Lexington line of machine pistols since the 2030s, the standard-issue sidearm for NCPD patrol officers.");
    this.Text("AmmoExpanded-MilitechPrototype-Name", "Militech Prototype Rounds");
    this.Text("AmmoExpanded-MilitechPrototype-Desc", "Experimental ammunition for Militech prototype weapons. Extremely rare.");
    this.Text("AmmoExpanded-Cal9x19-CHEM-Name", "9x19mm Parabellum Chemical");
    this.Text("AmmoExpanded-Cal9x19-CHEM-Desc", "9x19mm cartridge containing an engineered rapidly-decaying neurotoxin. The projectile is designed to fragment inside the body, allowing the neurotoxin to spread, resulting in the disruption of muscle function and neural transmission.");
    this.Text("AmmoExpanded-Cal243Win-Name", ".243 Winchester");
