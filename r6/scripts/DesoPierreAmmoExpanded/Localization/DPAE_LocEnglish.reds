    this.Text("AmmoExpanded-Cal308Win-CHEM-Desc", ".308 Winchester cartridge containing an engineered rapidly-decaying neurotoxin, delivered directly into the bloodstream on impact.");
    this.Text("AmmoExpanded-Cal308Win-NL-Desc", ".308 Winchester cartridge with a rubber projectile. Incapacitates the target.");
    this.Text("AmmoExpanded-Cal308Win-HE-Desc", ".308 Winchester cartridge containing explosive compound. Devastating to all targets.");
